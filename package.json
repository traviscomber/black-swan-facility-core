{
  "name": "black-swan-facility-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "node scripts/generate-legacy-translations.mjs && tsc --noEmit --pretty false",
    "prebuild": "node scripts/check-no-ai-sdk.mjs && pnpm typecheck && pnpm test:inventory && node --experimental-strip-types --test tests/map-overlay-loader.test.ts tests/map-overlay-runtime.test.ts tests/map-gis-derivative-contract.test.ts tests/map-overlay-derivative.test.ts tests/map-performance-contract.test.ts && node --experimental-strip-types --test tests/task-notification.test.ts && node --experimental-strip-types --test tests/booking-rules.test.ts && node --experimental-strip-types --test tests/booking-drag.test.ts && node --experimental-strip-types --test tests/booking-source-policy.test.ts && node --experimental-strip-types --test tests/discovery-evaluation-flow.test.ts && node --experimental-strip-types --test tests/access-capabilities.test.ts && pnpm test:os",
    "build": "NODE_OPTIONS=--import=./scripts/suppress-known-build-warning.mjs next build",
    "predev": "node scripts/generate-legacy-translations.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test:inventory": "node --experimental-strip-types --test tests/inventory-count-contract.test.ts tests/inventory-custody-contract.test.ts tests/inventory-maintenance-contract.test.ts tests/inventory-asset-audit-contract.test.ts tests/inventory-replenishment-contract.test.ts",
    "test:notifications": "node --experimental-strip-types --test tests/task-notification.test.ts",
    "test:booking": "node --experimental-strip-types --test tests/booking-rules.test.ts && node --experimental-strip-types --test tests/booking-drag.test.ts && node --experimental-strip-types --test tests/booking-source-policy.test.ts",
    "test:drag": "node --experimental-strip-types --test tests/booking-drag.test.ts",
    "test:source-policy": "node --experimental-strip-types --test tests/booking-source-policy.test.ts",
    "test:discovery": "node --experimental-strip-types --test tests/discovery-evaluation-flow.test.ts",
    "test:os-navigation": "node --experimental-strip-types --test tests/os-navigation.test.ts",
    "test:os": "node --experimental-strip-types --test tests/os-navigation.test.ts tests/os-home-contract.test.ts tests/os-shell-contract.test.ts tests/os-route-context.test.ts tests/temporal-foundation.test.ts tests/activities-timeline.test.ts tests/activities-calendar-contract.test.ts tests/os-compatibility.test.ts",
    "test:e2e:booking": "node scripts/run-booking-calendar-e2e.mjs",
    "map:backfill-derivatives": "node scripts/backfill-gis-overlay-derivatives.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "sharp"
    ]
  },
  "dependencies": {
